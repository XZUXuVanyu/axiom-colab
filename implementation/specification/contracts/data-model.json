      "stderr_limit": "uint64"
    },
    "ProcessObservation": {
      "job_id": "Id",
      "state": "Job state",
      "exit_code": "nullable int32",
      "elapsed_ms": "uint64",
      "stdout_ref": "optional host log ref",
      "stderr_ref": "optional host log ref",
      "outputs": "staged artifact observations",
      "isolation_result": "passed/failed/not_run"
    },
    "ResolvedToolCall": {
      "package_hash": "Hash",
      "tool_id": "string",
      "request": "ToolRequest",
      "policy": "ExecutionPolicy",
      "resolved_inputs": "authorized exact artifact files",
      "budget": "ResourceBudget"
    },
    "ToolCallObservation": {
      "job_id": "Id",
      "state": "Job state",
      "outputs": "optional committed ToolOutput",
      "error": "optional Error"
    },
    "PutComputeRequest": {
      "workspace_id": "Id",
      "object_id": "nullable Id",
      "expected_revision": "Revision (0 create)",
      "type_id": "registered ID",
      "payload": "validated type-specific value",
      "actor": "host session only"
    },
    "ObjectRecord": {
      "artifact": "ArtifactRef",
      "kind": "compute/working/artifact",
      "metadata": "ArtifactRecord metadata",
      "payload": "inline registered value or content address",
      "origin": "recorded provenance"
    },
    "AuditEvent": {
      "utc": "timestamp",
      "actor_kind": "model/reviewer/validator/system",
      "session_id": "Id",

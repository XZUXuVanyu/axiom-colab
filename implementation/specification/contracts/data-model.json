      "permissions": "Capability[]",
      "services": "exact service dependencies",
      "resources": "timeout/memory/output limits",
      "model_assumptions": "UTF-8 bounded text",
      "execution_domain": "batch"
    },
    "Graph": {
      "schema_version": 1,
      "graph_id": "Id",
      "revision": "Revision",
      "nodes": "Node[]",
      "edges": "Edge[]",
      "exposed_ports": "Mapping[]"
    },
    "Node": {
      "node_id": "Id",
      "package_hash": "Hash",
      "input_literals": "port_id->registered typed value",
      "params": "descriptor schema",
      "execution_policy": "ExecutionPolicy"
    },
    "Edge": {
      "source_node": "Id",
      "output_port": "string",
      "target_node": "Id",
      "input_port": "string"
    },
    "RunSnapshot": {
      "run_id": "Id",
      "workspace_id": "Id",
      "goal_id": "Id",

      "operation": "catalog name",
      "target": "Id/hash",
      "request_digest": "Hash",
      "result_digest": "Hash",
      "public_error": "optional Error"
    },
    "ValidatedGraph": {
      "graph": "Graph",
      "semantic_hash": "Hash",

      "resolved_bindings": "immutable package descriptors",
      "permission_union": "capability set"
    },
    "ResolvedBindingSet": {
      "bindings": "map package_hash to exact descriptor/permissions/dependency closure"
    },
    "ApprovedPlan": {
      "plan_id": "Id",
      "plan_hash": "Hash",
      "goal_id": "Id",
      "allowed_bindings": "exact binding IDs",
      "budget_seconds": "bounded uint32",
      "approval_id": "host verified Id"
    },
    "RunEnvironment": {
      "workspace_id": "Id",
      "run_id": "Id",
      "target": "platform",
      "toolchain_hash": "Hash",
      "library_lock_hash": "Hash",
      "policy_hash": "Hash"
    }

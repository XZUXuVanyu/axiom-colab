      "suite_hashes": "array",
      "validator_version": "semver",
      "policy_hash": "Hash",
      "environment_hash": "Hash",
      "case_results": "private/public split",
      "conclusion": "passed/failed/incomplete",
      "evidence_refs": "array",
      "created_at": "UTC"
    },
    "ReleaseManifest": {
      "tool_id": "stable dotted name",
      "version": "semver",
      "kind": "atomic/composite/source/product",
      "target": "windows-x64-msvc143",
      "sdk_version": "1.0.0",
      "toolchain_fingerprint": "Hash",
      "descriptor_hash": "Hash",
      "files": "sorted relative files/hash/size/role",
      "dependencies": "exact package/service IDs",
      "permissions": "sorted capability set",
      "license_refs": "array",
      "validation_summary_ref": "sanitized public reference"

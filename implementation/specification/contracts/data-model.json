      "quantity_kind": "registered ID",
      "unit_id": "registered ID",
      "required": "bool",
      "default": "optional valid typed value",
      "bounds": "optional min/max/maxItems"
    },
    "ExecutionPolicy": {
      "algorithm_id": "string",
      "algorithm_version": "semver",
      "backend": "cpu",

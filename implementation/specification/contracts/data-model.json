      "tolerance": "optional positive float64",
      "max_steps": "optional uint64 decimal"
    },
    "ToolDescriptor": {
      "schema_version": 1,
      "tool_id": "stable dotted name",
      "version": "semver",
      "inputs": "PortSpec[]",

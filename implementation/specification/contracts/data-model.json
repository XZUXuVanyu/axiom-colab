{
  "schema_version": 1,
  "encoding_rules": "specs/04-contracts-and-science.md",
  "types": {
    "Id": {
      "encoding": "string",
      "format": "<type-prefix>_<32 lower hex>",
      "generated_by": "host BCrypt RNG"
    },
    "Hash": {
      "encoding": "string",
      "format": "64 lower hex",
      "algorithm": "SHA-256"
    },
    "Revision": {
      "encoding": "string",
      "format": "canonical uint64 decimal",
      "initial": "1",
      "create_expected": "0"
    },
    "Error": {
      "code": "ErrorCode",
      "message": "public UTF-8 <=4096",
      "correlation_id": "Id",
      "details": "closed optional fields reason, current_revision, log_ref"
    },
    "ArtifactRef": {
      "workspace_id": "Id",
      "object_id": "Id",
      "revision": "Revision",
      "content_hash": "Hash",
      "type_id": "registered type",
      "bytes": "uint64 decimal"
    },
    "Snapshot": {
      "schema_version": 1,
      "snapshot_id": "Id",
      "project_id": "Id",
      "design_hash": "Hash",
      "files": "sorted [{relative_path,hash,bytes,role}]",
      "dependency_lock_hash": "Hash",
      "snapshot_hash": "Hash excluding itself"
    },
    "Candidate": {
      "candidate_id": "Id",
      "workspace_id": "Id",
      "project_id": "Id",
      "design_hash": "Hash",
      "snapshot_hash": "Hash",
      "descriptor_hash": "Hash",
      "dependency_lock_hash": "Hash",
      "build_recipe_hash": "Hash",
      "target": "windows-x64-msvc143",
      "permissions": "sorted capability set",
      "state": "captured/building/built/validating/passed/failed/incomplete"
    },
    "ValidationRecord": {
      "validation_id": "Id",
      "candidate_id": "Id",
      "candidate_hash": "Hash",

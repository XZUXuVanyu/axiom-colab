      "started_at": "nullable UTC",
      "finished_at": "nullable UTC",
      "progress": "optional completed/total or indeterminate",
      "result_ref": "optional ArtifactRef",
      "public_error": "optional Error"
    },
    "ArtifactRecord": {
      "reference": "ArtifactRef",
      "metadata": "registered type-specific schema bound to manifest hash",
      "provenance": "source/run/algorithm/environment references",
      "science": "quantity_kind/unit/uncertainty status"
    },
    "ToolRequest": {
      "inputs": "map<port_id,registered ValueEnvelope>",
      "params": "closed descriptor parameters"
    },
    "ToolOutput": {
      "outputs": "map<port_id,ValueEnvelope or StagedArtifact>",
      "diagnostics": "closed public status/warning/counter record"
    },
    "CallContext": {
      "workspace_id": "WorkspaceId",
      "job_id": "JobId",
      "run_id": "optional Id",
      "call_id": "Id",
      "policy": "immutable ExecutionPolicy",
      "cancel": "read-only cancellation token",
      "artifacts": "job-scoped IArtifactAccess reference"
    },
    "StagedArtifact": {
      "logical_name": "safe job-local name",
      "type_id": "registered ID",
      "relative_path": "within output staging",
      "declared_hash": "Hash verified by host",
      "bytes": "uint64",
      "metadata": "type-specific record"
    },
    "ArtifactSpec": {
      "logical_name": "safe job-local name",
      "type_id": "registered ID",
      "metadata": "type-specific schema"
    },
    "ProcessSpec": {
      "executable": "host-only frozen path/hash",
      "argv": "vector<string>",
